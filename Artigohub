----------------------------------------------------------------------
-- 7. COUNTER LOGIC
----------------------------------------------------------------------
local S = { started = false, mode = nil, status = "off" }
local K = { t0 = 0, boostAt = 0, fly = Vector3.zero, stop = nil, stopIdx = -1, spawn = nil, list = {}, last = nil }
local UE = { legit = { last = 0, inPos = false }, bot = { last = 0, inPos = false }, voidState = 2, voidT = 0, lastRandTp = 0 }

local function cycleTimes()
	local cycle = math.max(cfg("CtrKiciaCycleMs", 50), 5) / 1000
	local flyWindow = math.min(cfg("CtrKiciaFlyMs", 25) / 1000, cycle * 0.95)
	return cycle, flyWindow
end

local function buildSpawnList(spawn, rageBlockers, rageSpotSafe)
	K.spawn = spawn; K.list = {}
	local blockers = rageBlockers and rageBlockers()
	local params = blockers and blockers.params
	if not params then return end
	local depth  = cfg("CtrKiciaDepth", 6)
	local radius = cfg("CtrKiciaRadius", 30)
	local rng = Random.new()
	for _ = 1, 60 do
		if #K.list >= 16 then break end
		local angle = rng:NextNumber(0, math.pi * 2)
		local dist  = rng:NextNumber(4, math.max(radius, 5))
		local origin = spawn + Vector3.new(math.cos(angle) * dist, 8, math.sin(angle) * dist)
		local ok, hit = pcall(function() return workspace:Raycast(origin, Vector3.new(0, -30, 0), params) end)
		if ok and hit and hit.Normal.Y > 0.7 then
			local spot = hit.Position - Vector3.new(0, depth, 0)
			if not rageSpotSafe or rageSpotSafe(spot) then K.list[#K.list + 1] = spot end
		end
	end
end

local function resolveStopPos(mode, spawn, rageBlockers, rageSpotSafe)
	local fallback = spawn - Vector3.new(0, cfg("CtrKiciaDepth", 6), 0)
	if mode ~= MODE_SOLIX then return fallback end
	if K.spawn ~= spawn then buildSpawnList(spawn, rageBlockers, rageSpotSafe) end
	local n = #K.list
	if n == 0 then return fallback end
	local idx = math.random(1, n)
	if n > 1 and idx == K.last then idx = idx % n + 1 end
	K.last = idx
	return K.list[idx]
end

local function kiciaSolixStep(mode, root, dt, now, rageBlockers, rageSpotSafe)
	local t = now - K.t0
	local cycle, flyWindow = cycleTimes()
	local flying = (t % cycle) < flyWindow
	if now >= K.boostAt then
		if flying then K.fly += Vector3.new(0, cfg("CtrKiciaBoost", 100000), 0) end
		K.boostAt = now + cfg("CtrKiciaBoostMs", 600) / 1000
	end
	if not flying then
		local idx = math.floor(t / cycle)
		if idx ~= K.stopIdx or not K.stop then
			K.stopIdx = idx
			K.stop = resolveStopPos(mode, K.spawn or root.Position, rageBlockers, rageSpotSafe)
		end
		root.CFrame = CFrame.new(K.stop) * CFrame.Angles(math.pi / 2, 0, 0)
	else
		local zig = math.cos(t * cfg("CtrKiciaZigFreq", 8)) * cfg("CtrKiciaZigAmp", 400) * dt
		K.fly += Vector3.new(zig, cfg("CtrKiciaFlySpeed", 15000) * dt, 0)
		root.CFrame = CFrame.new(K.fly) * CFrame.Angles(-math.pi / 2, 0, 0)
	end
	root.AssemblyLinearVelocity = Vector3.zero
end

local function kiciaSolixInit(root, now)
	K.t0 = now; K.boostAt = now; K.spawn = root.Position; K.fly = root.Position
	K.stop, K.stopIdx = nil, -1; K.list, K.last = {}, nil
end

local function ueCounterStep(now, dt, target, isLegit, helpers, setStatus)
	local char = helpers.getCharacter()
	local root = helpers.getRoot()
	local hum  = char and char:FindFirstChildOfClass("Humanoid")
	if not (root and hum) then return end
	helpers.prepCharacter(char)
	pcall(function() hum.PlatformStand = true; hum.WalkSpeed = 0 end)
	if target and target.Character then
		local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
		if tRoot then
			local P = isLegit and "Legit" or "Bot"
			local stay = cfg("Ctr" .. P .. "Stay", 35) / 100
			local gap = cfg("Ctr" .. P .. "Gap", 50) / 100
			local lead = cfg("Ctr" .. P .. "Lead", 6)
			local slot = isLegit and UE.legit or UE.bot
			if not slot.inPos then
				if now - slot.last >= gap then slot.inPos, slot.last = true, now end
			elseif now - slot.last >= stay then
				pcall(helpers.sendToVoid, root); slot.inPos, slot.last = false, now
			end
			if slot.inPos then
				local pos = tRoot.Position
				local vel = tRoot.AssemblyLinearVelocity
				if vel.Magnitude > 0.5 then pos += vel.Unit * lead end
				if helpers.isUnderMap and helpers.isUnderMap(pos) then pcall(helpers.sendToVoid, root); setStatus("target went under the map"); return end
				pcall(function()
					root.CFrame = CFrame.new(pos + Vector3.new(0, 0, 1), pos + tRoot.CFrame.LookVector) * CFrame.Angles(-math.pi / 2, 0, 0)
					root.AssemblyLinearVelocity = Vector3.zero
				end)
				setStatus(("on %s"):format(target.Name:sub(1, 14))); return
			end
			pcall(helpers.sendToVoid, root); setStatus(("waiting on %s"):format(target.Name:sub(1, 14))); return
		end
	end
	local elapsed = now - UE.voidT
	if UE.voidState == 1 then
		if elapsed >= 15 then UE.voidState, UE.voidT = 2, now
		else
			pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, cfg("CtrVoidSpeed", 3000), 0) end)
			if now - UE.lastRandTp >= 10 then
				UE.lastRandTp = now
				pcall(function()
					root.CFrame = CFrame.new(root.Position + Vector3.new(math.random(-2500, 2500), math.random(500, 1200), math.random(-2500, 2500))) * CFrame.Angles(-math.pi / 2, 0, 0)
				end)
			end
		end
	else
		local y = root.Position.Y
		local floorY = (helpers.mapCentreY and helpers.mapCentreY()) or (y - 1000)
		pcall(function() root.CFrame = CFrame.new(root.Position.X, y - (y - floorY) * 0.5, root.Position.Z) * CFrame.Angles(-math.pi / 2, 0, 0) end)
		UE.voidState, UE.voidT, UE.lastRandTp = 1, now, now
	end
	setStatus("in the void")
end

local ENV = {
	getRoot = function() local c = player.Character; return c and c:FindFirstChild("HumanoidRootPart") or nil end,
	say = function(s) refreshHud(s) end,
	stop = function() UE.legit.inPos, UE.bot.inPos = false, false end,
	rageActive = false, rageWanted = function() return false end,
	rageBlockers = function()
		local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = { player.Character }
		return { params = params }
	end,
	rageSpotSafe = nil, bots = {}, findLegit = function() return nil, 0 end, playerCount = #Players:GetPlayers(), lastArmTime = os.clock(), ueInit = nil,
	helpers = {
		getCharacter = function() return player.Character end,
		getRoot = function() local c = player.Character; return c and c:FindFirstChild("HumanoidRootPart") or nil end,
		prepCharacter = function(char) for _, d in ipairs(char:GetDescendants()) do if d:IsA("BasePart") then d.CanCollide = false; d.CanQuery = false end end end,
		sendToVoid = function(root) root.CFrame = CFrame.new(root.Position + Vector3.new(0, 500, 0)); root.AssemblyLinearVelocity = Vector3.zero end,
		isUnderMap = function(pos) return pos.Y < -500 end, mapCentreY = nil,
	},
}

local function counterTick(now, dt, env)
	local on = cfg("CtrOn", false)
	if not on then
		if S.started then env.stop() end
		S.started = false; S.status = "off"; env.say(S.status); return
	end

	local mode = cfg("CtrMode", MODE_UE)
	if S.started and S.mode and mode ~= S.mode then env.stop(); S.started = false; kiciaSolixInit(env.getRoot() or { Position = Vector3.zero }, now) end
	local root = env.getRoot()
	if not root then env.say("no character") return end
	if not S.started then
		S.started, S.mode = true, mode
		if mode == MODE_KICIA or mode == MODE_SOLIX then kiciaSolixInit(root, now) end
	end
	if mode == MODE_KICIA or mode == MODE_SOLIX then
		local ok, err = pcall(kiciaSolixStep, mode, root, dt, now, env.rageBlockers, env.rageSpotSafe)
		if not ok then S.status = "kicia error: " .. tostring(err) end
	else
		local delay = cfg("CtrLegitDelay", 3)
		local armed = delay <= 0 or (now - (env.lastArmTime or 0)) >= delay
		local target, isLegit = nil, false
		if cfg("CtrLegits", true) and armed then
			local legit, legitCount = env.findLegit()
			if legit then target, isLegit = legit, true
			elseif (legitCount or 0) > math.floor(cfg("CtrMaxLegits", 1)) then S.status = ("%d legits, over the cap"):format(legitCount) end
		end
		if not target and cfg("CtrBots", true) and env.bots and #env.bots > 0 then target, isLegit = env.bots[1], false end
		pcall(ueCounterStep, now, dt, target, isLegit, env.helpers, function(s) S.status = s end)
	end
	env.say(("%s - %s"):format(S.mode or "?", S.status))
end

