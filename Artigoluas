-- Environment
----------------------------------------------------------------------
local function getRoot()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") or nil
end

local ENV = {
	getRoot = getRoot,
	say = function(s) refreshHud(s) end,
	stop = function()
		UE.legit.inPos, UE.bot.inPos = false, false
	end,
	rageActive = false,
	rageWanted = function() return false end,
	rageBlockers = function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character }
		return { params = params }
	end,
	rageSpotSafe = nil,
	bots = {},
	findLegit = function() return nil, 0 end,
	playerCount = #Players:GetPlayers(),
	lastArmTime = os.clock(),
	ueInit = nil,
	helpers = {
		getCharacter = function() return player.Character end,
		getRoot = getRoot,
		prepCharacter = function(char)
			for _, d in ipairs(char:GetDescendants()) do
				if d:IsA("BasePart") then
					d.CanCollide = false
					d.CanQuery = false
				end
			end
		end,
		sendToVoid = function(root)
			root.CFrame = CFrame.new(root.Position + Vector3.new(0, 500, 0))
			root.AssemblyLinearVelocity = Vector3.zero
		end,
		isUnderMap = function(pos) return pos.Y < -500 end,
		mapCentreY = nil,
	},
}

----------------------------------------------------------------------
-- Main tick
----------------------------------------------------------------------
local S = { started = false, mode = nil, status = "off" }

local function counterTick(now, dt, env)
	local on = cfg("CtrOn", false)
	local rageOn = env.rageActive or (env.rageWanted and env.rageWanted())

	if on and rageOn then
		if S.started then env.stop(true) end
		S.started = false
		S.status = "paused - ragebot is on"
		env.say(S.status)
		return
	end
	if not on then
		if S.started then env.stop() end
		S.started = false
		S.status = "off"
		env.say(S.status)
		return
	end

	local mode = cfg("CtrMode", MODE_UE)
	if S.started and S.mode and mode ~= S.mode then
		env.stop()
		S.started = false
		kiciaSolixInit(getRoot() or { Position = Vector3.zero }, now)
	end

	local root = env.getRoot()
	if not root then env.say("no character") return end

	if not S.started then
		S.started, S.mode = true, mode
		if mode == MODE_KICIA or mode == MODE_SOLIX then
			kiciaSolixInit(root, now)
		end
		if mode == MODE_UE and env.ueInit then
			pcall(env.ueInit, root)
		end
	end

	if mode == MODE_KICIA or mode == MODE_SOLIX then
		local ok, err = pcall(kiciaSolixStep, mode, root, dt, now, env.rageBlockers, env.rageSpotSafe)
		if not ok then S.status = "kicia error: " .. tostring(err) end
	else
		local delay = cfg("CtrLegitDelay", 3)
		local armed = delay <= 0 or (now - (env.lastArmTime or 0)) >= delay
		local target, isLegit = nil, false

		if cfg("CtrLegits", true) and armed then
			local legit, legitCount = env.findLegit()
			if legit then
				target, isLegit = legit, true
			elseif (legitCount or 0) > math.floor(cfg("CtrMaxLegits", 1)) then
				S.status = ("%d legits, over the cap"):format(legitCount)
			end
		end
		if not target and cfg("CtrBots", true) and env.bots and #env.bots > 0 then
			target, isLegit = env.bots[1], false
		end

		pcall(ueCounterStep, now, dt, target, isLegit, env.helpers, function(s) S.status = s end)

		if not armed and S.status == "in the void" then
			S.status = ("legits arm in %.1fs"):format(delay - (now - (env.lastArmTime or 0)))
		end
		if (env.playerCount or 0) == 0 then S.status = "nobody in the server" end
	end

	env.say(("%s - %s"):format(S.mode or "?", S.status))
end

----------------------------------------------------------------------
-- 6. Side Button Logic & Dragging
----------------------------------------------------------------------
local isOpen = true
local isLocked = false

local openBtn, openLbl = makeSideButton(0, "Toggle UI", function()
	isOpen = not isOpen
	frame.Visible = isOpen
	snowGui.Enabled = isOpen
end)

local lockBtn, lockLbl = makeSideButton(1, "Lock UI", function()
	isLocked = not isLocked
	lockLbl.Text = isLocked and "Unlock" or "Lock UI"
	lockBtn.BackgroundColor3 = isLocked and Color3.fromRGB(50, 50, 50) or Color3.fromRGB(15, 15, 15)
end)

-- Dragging logic (Checks if isLocked)
do
	local dragging, dragStart, startPos
	frame.InputBegan:Connect(function(input)
		if isLocked then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging, dragStart, startPos = true, input.Position, frame.Position
		end
	end)
	frame.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and not isLocked and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end)
end

local last = os.clock()
RunService.Heartbeat:Connect(function()
	local now = os.clock()
	local dt = now - last
	last = now
	if Settings.CtrHud then
		if not gui.Parent then gui.Parent = playerGui end
		pcall(counterTick, now, dt, ENV)
	elseif gui.Parent then
		gui.Parent = nil
	end
end)

-- Initialize first tab and enable snow (since GUI starts open)
selectTab(1)
snowGui.Enabled = true
